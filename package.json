{
  "name": "example",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "prepare": "git config core.hooksPath .githooks || true",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "test:stories": "vitest run --project=storybook",
    "test:visual": "playwright test",
    "test:visual:docker": "scripts/visual-tests-docker.sh",
    "test:visual:update": "scripts/visual-tests-docker.sh --update-snapshots"
  },
  "dependencies": {
    "next": "16.4.5",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@storybook/addon-a11y": "^10.6.6",
    "@storybook/addon-docs": "^10.6.6",
    "@storybook/addon-mcp": "^10.6.6",
    "@storybook/addon-vitest": "^10.6.6",
    "@storybook/nextjs-vite": "^10.6.6",
    "@tailwindcss/turbopack": "^4",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/browser-playwright": "^4",
    "@vitest/coverage-v8": "^4",
    "eslint": "^9",
    "eslint-config-next": "16.4.5",
    "playwright": "1.65.0",
    "storybook": "^10.6.6",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vite": "^8.3.6",
    "vitest": "^4"
  },
  "packageManager": "pnpm@12.10.1",
  "engines": {
    "node": "26.x"
  }
}
